# One env file for the whole repo. Copy this file to .env (repo root) and fill in what you need.
# The sample workspace runs without environment variables.
# apps/web loads it through next.config.ts; Supabase functions load it with `npm run functions:serve`.

# Supabase (enables the separate /login + /live foundation).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put a service role or provider secret in NEXT_PUBLIC_* variables.

# Stripe sandbox only. Prefer a restricted sandbox key with Prices read and Checkout Sessions write.
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_SANDBOX_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Server-only Supabase secret or legacy service_role key, used only by the verified Stripe webhook.
SUPABASE_SECRET_KEY=

# Optional Google AI Studio / Gemini summary provider. Never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=

# Vercel AI Gateway key, used by Supabase Edge Functions. Never sent to the browser.
AI_GATEWAY_API_KEY=
