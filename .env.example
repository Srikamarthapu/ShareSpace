# One env file for the whole repo. Copy this file to .env (repo root) and fill in what you need.
# Real sign-in and workspace features require the Supabase variables below.
# apps/web loads it through next.config.ts; Supabase functions load it with `npm run functions:serve`.
# Existing shell/deployment variables and apps/web/.env.local values take precedence.

# Supabase (email/password sign-in at /login and the real workspace at /live).
# Allow the exact /auth/callback URLs for localhost and your Vercel preview/production domains.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put a service role or provider secret in NEXT_PUBLIC_* variables.

# Stripe sandbox only. See apps/web/src/lib/billing/README.md for required permissions.
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_SANDBOX_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Server-only Supabase secret or legacy service_role key for authorized billing operations.
SUPABASE_SECRET_KEY=

# Edge Function origin allowlist. The first URL is used for pairing approval links.
APP_ORIGIN=http://localhost:3000

# Jev overlap classification. Official TypeSafe typed SystemOne API.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# Optional DeepSeek compaction helper. Capture does not enable it automatically.
# Send only selected, redacted text with explicit summarization consent.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional Google AI Studio / Gemini summary provider. Never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional Vercel AI Gateway key. Never sent to the browser.
AI_GATEWAY_API_KEY=
