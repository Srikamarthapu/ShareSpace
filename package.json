{
  "name": "sharespace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared project context for builders and their coding agents.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23 || >=24 <25"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "npm run dev --workspace @workspace/web",
    "build": "npm run build --workspace @workspace/web",
    "start": "npm run start --workspace @workspace/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "adapter": "npm run cli --workspace @workspace/adapter --",
    "functions:serve": "supabase functions serve --env-file .env"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
