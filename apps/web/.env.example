# The sample workspace runs without environment variables.
# Copy this file to apps/web/.env.local to enable the separate /login + /live foundation.
# GitHub OAuth must also be enabled in Supabase Auth with your GitHub OAuth app.
# Allow the exact /auth/callback URLs for localhost and your Vercel preview/production domains.
# Sample setup/invites/history never access these real-account credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put a service role or provider secret in NEXT_PUBLIC_* variables.

# Stripe sandbox only. Prefer a restricted sandbox key with Prices read and Checkout Sessions write.
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_SANDBOX_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Server-only Supabase secret or legacy service_role key, used only by the verified Stripe webhook.
SUPABASE_SECRET_KEY=

# Optional Google AI Studio / Gemini summary provider. Never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=
